---
import {
  type Lang,
  site,
  ui,
  experience,
  education,
  languages,
  projects,
  skills,
} from '../data/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const other: Lang = lang === 'fr' ? 'en' : 'fr';
const otherHref = other === 'fr' ? base : `${base}en/`;
const t = (v: { fr: string; en: string }) => v[lang];
const navItems = ['about', 'experience', 'projects', 'skills', 'contact'] as const;
const filterKeys = ['all', 'ai', 'data', 'software', 'graphics'] as const;
---

<!-- Navigation -->
<header
  class="fixed inset-x-0 top-0 z-50 bg-white/50 backdrop-blur-md transition-colors dark:bg-slate-950/40"
>
  <nav class="mx-auto flex h-20 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      Germain<span class="text-accent-500">.</span>P
    </a>
    <ul class="hidden items-center gap-9 text-lg font-medium md:flex">
      {
        navItems.map((k) => (
          <li>
            <a href={`#${k}`} class="transition hover:text-accent-500">
              {t(ui.nav[k])}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-2">
      <a
        href={otherHref}
        class="rounded-lg border border-slate-200 px-3 py-2 font-mono text-sm font-medium uppercase transition hover:border-accent-500 hover:text-accent-500 dark:border-slate-700"
        aria-label={lang === 'fr' ? 'Switch to English' : 'Passer en français'}
      >
        {other}
      </a>
      <button
        id="theme-toggle"
        class="rounded-lg border border-slate-200 p-2 transition hover:border-accent-500 hover:text-accent-500 dark:border-slate-700"
        aria-label="Toggle dark mode"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button
        id="menu-toggle"
        class="rounded-lg border border-slate-200 p-2 md:hidden dark:border-slate-700"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </nav>
  <ul id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-5 py-3 md:hidden dark:border-slate-800 dark:bg-slate-950">
    {
      navItems.map((k) => (
        <li>
          <a href={`#${k}`} class="block py-2.5 text-lg font-medium hover:text-accent-500">
            {t(ui.nav[k])}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<main id="top">
  <!-- Hero -->
  <section class="relative overflow-hidden px-5 pb-20 pt-36 md:pt-44">
    <div
      class="pointer-events-none absolute -top-40 right-0 h-[480px] w-[480px] rounded-full bg-accent-400/20 blur-3xl dark:bg-accent-500/10"
    >
    </div>
    <div class="relative mx-auto flex max-w-6xl flex-col-reverse items-center gap-12 md:flex-row md:justify-between">
      <div class="max-w-2xl text-center md:text-left">
        <p
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-300 bg-emerald-50 px-4 py-1.5 text-sm font-medium text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-300"
        >
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          </span>
          {t(ui.hero.status)}
        </p>
        <p class="font-mono text-sm text-accent-600 dark:text-accent-400">{t(ui.hero.hello)}</p>
        <h1 class="mt-2 text-5xl font-extrabold tracking-tight text-slate-900 md:text-7xl dark:text-white">
          {site.name}
        </h1>
        <p class="mt-4 text-xl font-semibold text-slate-800 md:text-2xl dark:text-slate-200">
          {t(ui.hero.roles)}
        </p>
        <p class="mt-5 text-base leading-relaxed md:text-lg">{t(ui.hero.tagline)}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            href="#contact"
            class="inline-flex items-center rounded-2xl bg-accent-500 px-7 py-4 text-lg font-semibold text-white shadow-lg shadow-accent-500/25 transition hover:-translate-y-0.5 hover:bg-accent-600"
          >
            {t(ui.hero.contact)}
          </a>
          <a
            href={`${base}${t(site.cv)}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2.5 rounded-2xl border border-slate-300 px-7 py-4 text-lg font-semibold text-slate-800 transition hover:-translate-y-0.5 hover:border-accent-500 hover:text-accent-600 dark:border-slate-700 dark:text-slate-200"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16"></path></svg>
            {t(ui.hero.cv)}
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="rounded-2xl border border-slate-300 p-4 transition hover:-translate-y-0.5 hover:border-accent-500 hover:text-accent-600 dark:border-slate-700"
          >
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .5z"></path></svg>
          </a>
          {
            site.linkedin && (
              <a
                href={site.linkedin}
                target="_blank"
                rel="noopener"
                aria-label="LinkedIn"
                class="rounded-2xl border border-slate-300 p-4 transition hover:-translate-y-0.5 hover:border-accent-500 hover:text-accent-600 dark:border-slate-700"
              >
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6c.5-.9 1.6-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.6V9h3.5v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"></path></svg>
              </a>
            )
          }
        </div>
      </div>
      <div class="relative shrink-0">
        <div class="absolute -inset-3 rounded-full bg-gradient-to-tr from-accent-500 to-violet-500 opacity-70 blur-xl"></div>
        <img
          src={`${base}${site.photo}`}
          alt={site.name}
          width="400"
          height="400"
          class="relative h-48 w-48 rounded-full border-4 border-white object-cover shadow-xl md:h-72 md:w-72 dark:border-slate-900"
        />
      </div>
    </div>
  </section>

  <!-- À propos -->
  <section id="about" class="px-5 py-24">
    <div class="mx-auto max-w-6xl">
      <h2 class="section-title reveal">{t(ui.sections.about)}</h2>
      <p class="reveal max-w-3xl text-lg leading-relaxed">{t(ui.about)}</p>

      <div class="mt-14 grid gap-10 lg:grid-cols-5">
        <div class="reveal lg:col-span-3">
          <h3 class="mb-5 text-lg font-bold text-slate-900 dark:text-white">{t(ui.sections.education)}</h3>
          <ol class="space-y-4">
            {
              education.map((e) => (
                <li class="card flex items-start gap-4 p-5">
                  <img src={`https://flagcdn.com/w40/${e.flag}.png`} alt="" width="28" height="20" class="mt-1 rounded-sm" loading="lazy" />
                  <div class="flex-1">
                    <div class="flex flex-wrap items-baseline justify-between gap-2">
                      <p class="font-semibold text-slate-900 dark:text-white">{e.school}</p>
                      <span class="font-mono text-sm text-accent-600 dark:text-accent-400">{e.dates}</span>
                    </div>
                    <p class="mt-1 text-sm">{t(e.degree)}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="reveal lg:col-span-2">
          <h3 class="mb-5 text-lg font-bold text-slate-900 dark:text-white">{t(ui.sections.languages)}</h3>
          <div class="card space-y-5 p-6">
            {
              languages.map((l) => (
                <div>
                  <div class="mb-1.5 flex justify-between text-sm">
                    <span class="font-medium text-slate-900 dark:text-white">{t(l.name)}</span>
                    <span class="text-slate-500 dark:text-slate-400">{t(l.level)}</span>
                  </div>
                  <div class="h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
                    <div class="h-full rounded-full bg-gradient-to-r from-accent-500 to-violet-500" style={`width:${l.percent}%`} />
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Expérience -->
  <section id="experience" class="px-5 py-24">
    <div class="mx-auto max-w-6xl">
      <h2 class="section-title reveal">{t(ui.sections.experience)}</h2>
      <ol class="relative ml-3 border-l-2 border-slate-200 dark:border-slate-800">
        {
          experience.map((x, i) => (
            <li class="reveal relative mb-10 pl-8 last:mb-0">
              <span
                class:list={[
                  'absolute -left-[9px] top-6 h-4 w-4 rounded-full border-4 border-white dark:border-slate-950',
                  i === 0 ? 'bg-accent-500' : 'bg-slate-400 dark:bg-slate-600',
                ]}
              />
              <article class="card p-6 hover:border-accent-500/50 hover:shadow-md">
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">{t(x.role)}</h3>
                    <p class="mt-0.5 font-medium text-accent-600 dark:text-accent-400">{x.org}</p>
                  </div>
                  <div class="text-right text-sm">
                    <p class="font-mono text-sm">{t(x.dates)}</p>
                    <p class="mt-1 inline-flex items-center gap-1.5 text-slate-500 dark:text-slate-400">
                      <img src={`https://flagcdn.com/w20/${x.flag}.png`} alt="" width="16" height="12" class="rounded-[2px]" loading="lazy" />
                      {t(x.place)}
                    </p>
                  </div>
                </div>
                <ul class="mt-4 space-y-2 text-sm leading-relaxed">
                  {x.bullets.map((b) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent-500" />
                      <span>{t(b)}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-4 flex flex-wrap gap-2">
                  {x.tags.map((tag) => (
                    <span class="chip">{tag}</span>
                  ))}
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Projets -->
  <section id="projects" class="px-5 py-24">
    <div class="mx-auto max-w-6xl">
      <h2 class="section-title reveal">{t(ui.sections.projects)}</h2>
      <div class="reveal mb-8 flex flex-wrap gap-2" id="filters">
        {
          filterKeys.map((k, i) => (
            <button
              data-filter={k}
              class:list={[
                'filter-btn rounded-full border px-4 py-1.5 text-sm font-medium transition',
                i === 0
                  ? 'border-accent-500 bg-accent-500 text-white'
                  : 'border-slate-300 hover:border-accent-500 dark:border-slate-700',
              ]}
            >
              {t(ui.filters[k])}
            </button>
          ))
        }
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {
          projects.map((p) => (
            <article
              class="project card reveal group flex flex-col overflow-hidden hover:-translate-y-1 hover:shadow-xl"
              data-categories={p.categories.join(' ')}
            >
              <div class="relative aspect-[16/9] overflow-hidden">
                {p.image ? (
                  <img
                    src={`${base}${p.image}`}
                    alt={p.title}
                    loading="lazy"
                    class:list={[
                      'h-full w-full transition duration-500 group-hover:scale-105',
                      p.imageFit === 'contain' ? 'object-contain px-4 pb-2 pt-10' : 'object-cover',
                    ]}
                    style={p.imageFit === 'contain' ? `background:${p.imageBg ?? '#ffffff'}` : undefined}
                  />
                ) : (
                  <div
                    class="flex h-full w-full items-center justify-center transition duration-500 group-hover:scale-105"
                    style={`background:${p.cover}`}
                  >
                    <div
                      class="absolute inset-0 opacity-20"
                      style="background-image:radial-gradient(circle at 1px 1px,#fff 1px,transparent 0);background-size:18px 18px"
                    />
                    <span class="relative rounded-lg bg-black/25 px-4 py-2 font-mono text-sm text-white backdrop-blur-sm">
                      {p.coverLabel}
                    </span>
                  </div>
                )}
                <div class="absolute left-3 top-3 flex gap-1.5">
                  {p.categories.map((c) => (
                    <span class="rounded-full bg-white/90 px-2.5 py-0.5 text-sm font-semibold text-slate-800">
                      {t(ui.filters[c])}
                    </span>
                  ))}
                </div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white">{p.title}</h3>
                <p class="mt-2 text-sm leading-relaxed">{t(p.summary)}</p>
                <ul class="mt-4 space-y-1.5 text-sm">
                  {p.details.map((d) => (
                    <li class="flex gap-2">
                      <span class="text-accent-500">▹</span>
                      <span>{t(d)}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-5 flex flex-wrap gap-2">
                  {p.stack.map((s) => (
                    <span class="chip">{s}</span>
                  ))}
                </div>
                <div class="mt-auto flex flex-wrap gap-4 pt-6 text-sm font-semibold">
                  {(['code', 'demo', 'dataset'] as const).map(
                    (k) =>
                      p.links[k] && (
                        <a
                          href={p.links[k]}
                          target="_blank"
                          rel="noopener"
                          class="inline-flex items-center gap-1 text-accent-600 hover:underline dark:text-accent-400"
                        >
                          {t(ui.links[k])}
                          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M7 17L17 7M9 7h8v8" /></svg>
                        </a>
                      ),
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Compétences -->
  <section id="skills" class="px-5 py-24">
    <div class="mx-auto max-w-6xl">
      <h2 class="section-title reveal">{t(ui.sections.skills)}</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          skills.map((s) => (
            <div class="card reveal p-6 hover:border-accent-500/50">
              <h3 class="font-bold text-slate-900 dark:text-white">{t(s.title)}</h3>
              {s.icons && (
                <img
                  src={`https://skillicons.dev/icons?i=${s.icons}&perline=8`}
                  alt={s.icons.replaceAll(',', ', ')}
                  loading="lazy"
                  class="mt-4 h-10"
                />
              )}
              <div class="mt-4 flex flex-wrap gap-2">
                {s.items.map((i) => (
                  <span class="chip">{i}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="px-5 pb-24">
    <div
      class="reveal relative mx-auto max-w-6xl overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900 to-accent-700 px-6 py-16 text-center text-white md:px-16"
    >
      <div
        class="absolute inset-0 opacity-10"
        style="background-image:radial-gradient(circle at 1px 1px,#fff 1px,transparent 0);background-size:22px 22px"
      >
      </div>
      <div class="relative">
        <h2 class="text-3xl font-extrabold tracking-tight md:text-4xl">{t(ui.sections.contact)}</h2>
        <p class="mx-auto mt-4 max-w-xl text-slate-300">{t(ui.contact.text)}</p>
        <a
          href={`mailto:${site.email}`}
          class="mt-8 inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3.5 font-semibold text-slate-900 transition hover:-translate-y-0.5 hover:bg-accent-50"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M22 6l-10 7L2 6"></path></svg>
          {site.email}
        </a>
        <p class="mt-6 text-sm text-slate-400">{t(ui.contact.location)}</p>
        <div class="mt-6 flex justify-center gap-5 text-sm font-medium">
          <a href={site.github} target="_blank" rel="noopener" class="hover:text-accent-400">GitHub</a>
          {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener" class="hover:text-accent-400">LinkedIn</a>}
          <a href={`${base}${t(site.cv)}`} target="_blank" rel="noopener" class="hover:text-accent-400">CV</a>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="border-t border-slate-200 px-5 py-8 text-center text-xs text-slate-500 dark:border-slate-800">
  © {new Date().getFullYear()} {site.name} · {t(ui.footer)}
</footer>

<script>
  // Thème clair / sombre
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  // Menu mobile
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));

  // Apparition des éléments au scroll
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.12 },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

  // Filtres des projets
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project');
  const active = ['border-accent-500', 'bg-accent-500', 'text-white'];
  const inactive = ['border-slate-300', 'dark:border-slate-700'];
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => {
        b.classList.remove(...active);
        b.classList.add(...inactive);
      });
      btn.classList.remove(...inactive);
      btn.classList.add(...active);
      cards.forEach((c) => {
        c.hidden = f !== 'all' && !c.dataset.categories!.split(' ').includes(f);
      });
    }),
  );
</script>
